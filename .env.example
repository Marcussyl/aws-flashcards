# MongoDB Atlas (M0 free) or a local MongoDB instance.
# Database name defaults to aws-flashcards if MONGODB_DB is omitted.
MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/aws-flashcards?tls=true&replicaSet=YOUR_REPLICA_SET&authSource=admin&retryWrites=true&w=majority
MONGODB_DB=aws-flashcards

# Cards live only in the MongoDB cards collection (no JSON seed/fallback).
# An empty collection means an empty deck.
# Progress stays in the separate `progress` collection as one document per card
# ({ userId, cardId, status, seen, updatedAt }; unique on { userId, cardId }).
# Until auth exists, userId is "local". A legacy `_id:"default"` mega-doc is
# auto-migrated to per-card docs on first read.
