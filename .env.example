# MongoDB Atlas (M0 free) or a local MongoDB instance.
# Database name defaults to aws-flashcards if MONGODB_DB is omitted.
MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/aws-flashcards?tls=true&replicaSet=YOUR_REPLICA_SET&authSource=admin&retryWrites=true&w=majority
MONGODB_DB=aws-flashcards

# Cards live only in the MongoDB cards collection (no JSON seed/fallback).
# An empty collection means an empty deck.
# Progress stays in the separate `progress` collection as one document per card
# ({ userId, cardId, status, seen, updatedAt }; unique on { userId, cardId }).
# Signed-in users use their GitHub user id; logged-out traffic still uses "local".
# A legacy `_id:"default"` mega-doc is auto-migrated to per-card docs on first read.
# After first GitHub login, local progress is copied onto the GitHub user if that
# user has none (or fewer docs) than the local partition.

# Auth.js (NextAuth v5) — GitHub OAuth. JWT sessions, no adapter.
# Generate AUTH_SECRET with: npx auth secret
#   or: openssl rand -base64 33
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Vercel sets VERCEL=1 which Auth.js treats as a trusted host. Set this anyway:
AUTH_TRUST_HOST=true
# Optional. Usually omit on Vercel (host is inferred). Only set if you use a
# custom Auth.js base path, e.g. AUTH_URL=https://your-domain/api/auth
# AUTH_URL=
